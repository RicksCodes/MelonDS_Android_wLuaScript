<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Only used to show which log is stored (date and type) -->
    <Preference
            android:key="log_info"
            android:selectable="false"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="log_view"
            android:title="@string/log_view"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="log_copy"
            android:title="@string/log_copy"
            android:summary="@string/log_copy_summary"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="log_share"
            android:title="@string/log_share"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="log_delete"
            android:title="@string/log_delete"
            app:iconSpaceReserved="false" />
</PreferenceScreen>
